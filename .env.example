# Reference only: the viewer does not load .env files.
# Leave CODEX_HOME unset or empty to use the current user's .codex directory.
CODEX_HOME=
# Claude Code data folder; empty uses ~/.claude (only the projects folder is read).
CLAUDE_CONFIG_DIR=
# pi agent data folder; empty uses ~/.pi/agent (only the sessions folder is read).
PI_CODING_AGENT_DIR=
# DeepSeek Harness home; empty uses ~/.dsh (only the sessions folder is read).
DSH_HOME=
